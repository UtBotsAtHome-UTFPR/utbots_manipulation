<?xml version="1.0"?>

<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="utbots_manipulator">

    <xacro:property name="PI" value="3.14159265358979323846"/>
    <xacro:property name="effort" value="10.0"/>   
    <xacro:property name="velocity" value="5.0"/>       

    <link name="world"/>

    <link name="base_link">
        <visual>
            <origin rpy="0 0 0" xyz="-0.015 0 0.38"/>
            <geometry>
                <mesh filename="package://manipulator_description/meshes/theseus_link_1.stl" scale="0.003 0.003 0.003"/>
            </geometry>
        </visual>
    </link>

    <joint name="base_arm_joint" type="fixed">
        <parent link="world"/>
        <child link="base_link"/>
        <origin rpy="0 0 0" xyz="0 0 0"/>
    </joint>

    <link name="arm_link_1">
        <visual>
            <origin rpy="0 0 0" xyz="0 0 0.075"/>
            <geometry>
                <mesh filename="package://manipulator_description/meshes/theseus_link_2.stl" scale="0.003 0.003 0.003"/>
            </geometry>
        </visual>
    </link>

    <joint name="arm_joint_1" type="revolute">
        <parent link="base_link"/>
        <child link="arm_link_1"/>
        <axis xyz="1 0 0"/>
        <origin rpy="0 0 0" xyz="0 0 0.31"/>
        <limit lower="-${PI/2}" upper="${PI/2}" effort="${effort}" velocity="${velocity}"/>
    </joint>

    <link name="arm_link_2">
        <visual>
            <origin rpy="0 0 0" xyz="0 0 -0.66"/>
            <geometry>
                <mesh filename="package://manipulator_description/meshes/theseus_link_3.stl" scale="0.003 0.003 0.003"/>
            </geometry>
        </visual>
    </link>

    <joint name="arm_joint_2" type="revolute">
        <parent link="arm_link_1"/>
        <child link="arm_link_2"/>
        <axis xyz="0 0 1"/>
        <origin rpy="0 0 0" xyz="0 0 0.75"/>
        <limit lower="-${PI/2}" upper="${PI/2}" effort="${effort}" velocity="${velocity}"/>
    </joint>

    <link name="arm_link_3">
        <visual>
            <origin rpy="0 0 0" xyz="0 0.22 -1.15"/>
            <geometry>
                <mesh filename="package://manipulator_description/meshes/theseus_link_4.stl" scale="0.003 0.003 0.003"/>
            </geometry>
        </visual>
    </link>

    <joint name="arm_joint_3" type="revolute">
        <parent link="arm_link_2"/>
        <child link="arm_link_3"/>
        <axis xyz="1 0 0"/>
        <origin rpy="0 0 0" xyz="0 -0.225 0.485"/>
        <limit lower="-${PI/2}" upper="${PI/2}" effort="${effort}" velocity="${velocity}"/>
    </joint>

    <link name="arm_link_4">
        <visual>
            <origin rpy="0 0 0" xyz="0 0.47 -0.24"/>
            <geometry>
                <mesh filename="package://manipulator_description/meshes/theseus_link_5.stl" scale="0.003 0.003 0.003"/>
            </geometry>
        </visual>
    </link>

    <joint name="arm_joint_4" type="revolute">
        <parent link="arm_link_3"/>
        <child link="arm_link_4"/>
        <axis xyz="1 0 0"/>
        <origin rpy="0 0 0" xyz="0 -0.25 -0.91"/>
        <limit lower="-${PI/2}" upper="${PI/2}" effort="${effort}" velocity="${velocity}"/>
    </joint>

    <!-- Primeiro 6cm, depois 34cm, depois 27cm -->

</robot>