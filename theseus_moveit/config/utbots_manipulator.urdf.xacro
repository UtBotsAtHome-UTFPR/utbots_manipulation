<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="utbots_manipulator">
    <xacro:arg name="initial_positions_file" default="initial_positions.yaml" />

    <!-- Import utbots_manipulator urdf file -->
    <xacro:include filename="$(find theseus_description)/urdf/theseus.urdf.xacro" />

    <!-- Import control_xacro -->
    <xacro:include filename="utbots_manipulator.ros2_control.xacro" />


    <xacro:utbots_manipulator_ros2_control name="FakeSystem" initial_positions_file="$(arg initial_positions_file)"/>

</robot>
