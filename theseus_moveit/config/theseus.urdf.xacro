<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="theseus">

    <!-- Import theseus urdf file -->
    <xacro:include filename="$(find theseus_description)/urdf/theseus.urdf.xacro" />

    <!-- Import control_xacro -->
    <xacro:include filename="$(find theseus_description)/urdf/theseus_ros2_control.xacro" />

</robot>
