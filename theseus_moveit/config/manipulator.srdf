<?xml version="1.0" encoding="UTF-8"?>

<robot name="manipulator">

    <!-- Arm Invese Kinematics Group -->
    <group name="arm">
        <chain base_link="base_arm_link" tip_link="claw_link"/>
        <joint name="arm_joint_1"/>
        <joint name="gripper_center_joint"/>
        <link name="gripper_center"/>
    </group>
    <end_effector name="gripper_claw_ee" parent_link="gripper_center" group="arm" parent_group="arm"/>
    
    <!-- Gripper Open/Close Movement -->
    <group name="gripper">
        <link name="gripper_right"/>
        <link name="gripper_left"/>
        <joint name="gripper_joint_1"/>
        <joint name="gripper_joint_2"/>
    </group>

    <!-- Defined States -->

    <!-- Standard Arm Position -->
    <group_state name="home" group="arm">
        <joint name="arm_joint_1" value="0.0"/>
        <joint name="hinge_joint_1" value="0.785398"/>
        <joint name="hinge_joint_2" value="4.71238"/>
    </group_state>

    <!-- Opened Gripper -->
    <group_state name="open" group="gripper">
        <joint name="gripper_joint_1" value="0.04"/>
        <joint name="gripper_joint_2" value="0.04"/>
    </group_state>

    <!-- Closed Gripper -->
    <group_state name="closed" group="gripper">
        <joint name="gripper_joint_1" value="0.0"/>
        <joint name="gripper_joint_2" value="0.0"/>
    </group_state>


    <!--DISABLE COLLISIONS: By default it is assumed that any link of the robot could potentially come into collision with any other link in the robot. This tag disables collision checking between a specified pair of links. -->
    <disable_collisions link1="arm_link_1" link2="claw_link" reason="Never"/>
    <disable_collisions link1="arm_link_1" link2="gripper_left" reason="Never"/>
    <disable_collisions link1="arm_link_1" link2="gripper_right" reason="Never"/>
    <disable_collisions link1="arm_link_1" link2="motor_link_1" reason="Adjacent"/>
    <disable_collisions link1="arm_link_1" link2="motor_link_2" reason="Adjacent"/>
    <disable_collisions link1="arm_link_2" link2="base_arm_link" reason="Never"/>
    <disable_collisions link1="arm_link_2" link2="claw_link" reason="Adjacent"/>
    <disable_collisions link1="arm_link_2" link2="gripper_left" reason="Default"/>
    <disable_collisions link1="arm_link_2" link2="gripper_right" reason="Default"/>
    <disable_collisions link1="arm_link_2" link2="motor_link_1" reason="Never"/>
    <disable_collisions link1="arm_link_2" link2="motor_link_2" reason="Adjacent"/>
    <disable_collisions link1="base_arm_link" link2="claw_link" reason="Never"/>
    <disable_collisions link1="base_arm_link" link2="gripper_left" reason="Never"/>
    <disable_collisions link1="base_arm_link" link2="motor_link_1" reason="Adjacent"/>
    <disable_collisions link1="base_arm_link" link2="motor_link_2" reason="Never"/>
    <disable_collisions link1="claw_link" link2="gripper_left" reason="Adjacent"/>
    <disable_collisions link1="claw_link" link2="gripper_right" reason="Adjacent"/>
    <disable_collisions link1="claw_link" link2="motor_link_1" reason="Never"/>
    <disable_collisions link1="claw_link" link2="motor_link_2" reason="Never"/>
    <!-- <disable_collisions link1="gripper_left" link2="gripper_right" reason="Default"/>  Should Collide -->
    <disable_collisions link1="gripper_left" link2="motor_link_1" reason="Never"/>
    <disable_collisions link1="gripper_left" link2="motor_link_2" reason="Never"/>
    <disable_collisions link1="gripper_right" link2="motor_link_1" reason="Never"/>
    <disable_collisions link1="gripper_right" link2="motor_link_2" reason="Never"/>
    <disable_collisions link1="motor_link_1" link2="motor_link_2" reason="Never"/>
    <disable_collisions link1="hinge_link_1" link2="motor_link_1" reason="Adjacent"/>
    <disable_collisions link1="hinge_link_2" link2="motor_link_2" reason="Adjacent"/>
</robot>
